<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Wholbase</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Wholbase | Wholesale Field Operations &amp; Delivery Platform</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0.0</string>
	<key>CFBundleVersion</key>
	<string>33</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<true/>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Wholbase uses your location to show your position on delivery routes and to record check-ins and deliveries while you are using the app.</string>

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Wholbase uses your location in the background during an active shift so dispatch can see delivery progress and route status, even when the app is not open.</string>

	<key>NSCameraUsageDescription</key>
	<string>Wholbase uses the camera to scan barcodes and to take proof-of-delivery and inventory photos.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>Wholbase lets you attach photos from your library to deliveries, orders and support requests.</string>

	<key>NSMicrophoneUsageDescription</key>
	<string>Wholbase may use the microphone when you record video or audio attachments.</string>

	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.wholbase.operations</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.wholbase.operations</string>
			</array>
		</dict>
	</array>

	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
		<string>location</string>
		<string>processing</string>
		<string>remote-notification</string>
	</array>

	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.floot.backgroundwake.refresh</string>
		<string>app.capgo.backgroundtask.processing</string>
	</array>
</dict>
</plist>
